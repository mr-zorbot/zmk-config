#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/reset.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&led_strip { chain-length = <27>; };

/ {
    keymap {
        compatible = "zmk,keymap";

        layer0 {
            display-name = "BAS";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp ESCAPE        &kp Q       &kp W  &kp E       &kp R  &kp T                   &kp Y          &kp U  &kp I          &kp O    &kp P          &kp SQT
&mt LEFT_ALT TAB  &mt LGUI A  &kp S  &kp D       &kp F  &kp G                   &kp H          &kp J  &kp K          &kp L    &mt RGUI SEMI  &mt RIGHT_ALT GRAVE
&kp BACKSLASH     &kp Z       &kp X  &kp C       &kp V  &kp B                   &kp N          &kp M  &kp COMMA      &kp DOT  &kp FSLH       &kp CARET
                                     &kp DELETE  &to 1  &mt LEFT_SHIFT SPACE    &mt RCTRL RET  &to 2  &kp BACKSPACE
            >;
        };

        layer1 {
            display-name = "LOW";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp NUMBER_1      &kp NUMBER_2          &kp NUMBER_3  &kp NUMBER_4  &kp N5         &kp NUMBER_6            &kp N7            &kp N8    &kp N8         &kp N0     &kp MINUS              &kp EQUAL
&mt LEFT_ALT TAB  &mt LGUI PRINTSCREEN  &kp HOME      &kp PAGE_UP   &kp PAGE_DOWN  &kp END                 &kp LEFT          &kp DOWN  &kp UP         &kp RIGHT  &mt RGUI LEFT_BRACKET  &mt RIGHT_ALT RIGHT_BRACKET
&trans            &trans                &trans        &trans        &trans         &trans                  &trans            &trans    &trans         &trans     &trans                 &trans
                                                      &kp DEL       &to 0          &mt LEFT_SHIFT SPACE    &mt RCTRL RETURN  &to 2     &kp BACKSPACE
            >;
        };

        raise_layer {
            display-name = "RAI";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp F1            &kp F2    &kp F3          &kp F4        &kp F5          &kp F6             &kp F7          &kp F8          &kp F9         &kp F10          &kp F11   &kp F12
&mt LEFT_ALT TAB  &kp LGUI  &msc SCRL_LEFT  &msc SCRL_UP  &msc SCRL_DOWN  &msc SCRL_RIGHT    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP   &mmv MOVE_RIGHT  &kp RGUI  &kp RIGHT_ALT
&trans            &trans    &trans          &trans        &trans          &trans             &trans          &trans          &trans         &trans           &trans    &trans
                                            &kp DEL       &to 1           &mkp RCLK          &mkp LCLK       &to 0           &kp BACKSPACE
            >;
        };
    };
};
